<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <!-- ================= header ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/circle_button"
                android:contentDescription="@string/app_name"
                android:padding="3dp"
                android:src="@drawable/logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/subtitle"
                    android:textColor="@color/ink_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/cat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:alpha="0.8"
                android:background="@drawable/circle_button"
                android:contentDescription="@string/cat_button"
                android:gravity="center"
                android:text="🐱"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ================= preview ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/preview"
                android:minHeight="140dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/status_idle"
                android:textColor="@color/ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ================= controls ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Label"
                android:text="@string/label_model" />

            <Spinner
                android:id="@+id/spinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <TextView
                style="@style/Label"
                android:layout_marginTop="14dp"
                android:text="@string/label_cap" />

            <Spinner
                android:id="@+id/cap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />

            <CheckBox
                android:id="@+id/gpu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:buttonTint="@color/purple"
                android:checked="true"
                android:text="@string/gpu_label"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- ================= actions ================= -->
        <Button
            android:id="@+id/run"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_primary"
            android:stateListAnimator="@null"
            android:text="@string/action_run"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/pick"
                style="@style/GhostButton"
                android:layout_weight="1"
                android:text="@string/action_pick" />

            <Button
                android:id="@+id/save"
                style="@style/GhostButton"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/action_save" />

            <Button
                android:id="@+id/diag"
                style="@style/GhostButton"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/action_diag" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/purple"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
